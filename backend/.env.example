# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Phoenix ERP Mock
ERP_BASE_URL=http://localhost:8000
ERP_BEARER_TOKEN=

# SSH
# Directory containing per-customer keys (case1_key.pem, case2_key.pem, ...)
SSH_KEYS_DIR=./keys
# Fallback key used when no per-customer key is found in SSH_KEYS_DIR
SSH_PRIVATE_KEY_PATH=./keys/id_rsa.pem
SSH_DEFAULT_USER=azureuser

# Timeouts
COMMAND_TIMEOUT_SECONDS=30
MAX_COMMAND_OUTPUT_CHARS=12000
